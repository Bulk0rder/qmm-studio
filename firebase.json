{
  "apphosting": {
    "backendId": "qmm-studio",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      ".next"
    ],
    "alwaysDeployFromSource": true
  },
  "hosting": {
    "target": "qmm-studio",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
